<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiDetector.ViewModels"
        xmlns:m="using:ApiDetector.Models"
        x:Class="ApiDetector.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="⚡ API Detector v2.0"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">

        <!-- 顶部配置区域 -->
        <Border Grid.Row="0" Classes="card">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">

                <!-- API 预设选择 -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,8">
                    <TextBlock Classes="title" Text="API 预设"/>
                    <ComboBox ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="m:ApiPreset">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 并发数 -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,16,8" Width="100">
                    <TextBlock Classes="title" Text="并发数"/>
                    <NumericUpDown Value="{Binding Concurrent}"
                                   Minimum="1" Maximum="2000" Increment="10"/>
                </StackPanel>

                <!-- 超时 -->
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,16,8" Width="80">
                    <TextBlock Classes="title" Text="超时(秒)"/>
                    <NumericUpDown Value="{Binding Timeout}"
                                   Minimum="1" Maximum="60" Increment="5"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                            VerticalAlignment="Center" Margin="8,0">
                    <Button Content="📁 加载文件"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Name="LoadFileButton"/>
                    <Button Content="▶️ 开始检测"
                            Command="{Binding StartCheckCommand}"
                            IsVisible="{Binding !IsRunning}"
                            Classes="accent"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="⏹️ 停止"
                            Command="{Binding StopCheckCommand}"
                            IsVisible="{Binding IsRunning}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- API URL -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1">
                    <TextBlock Classes="title" Text="API 端点"/>
                    <TextBox Text="{Binding ApiUrl}" Watermark="https://api.openai.com/v1/models"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*" Margin="0,8">

            <!-- 左侧：输入区域 -->
            <Border Classes="card" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="title" Text="API Keys (每行一个)"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding InputKeys}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Watermark="sk-xxxxxxxxxxxxxxxx&#x0a;sk-yyyyyyyyyyyyyyyy&#x0a;..."
                             FontFamily="Consolas, monospace"
                             FontSize="12"/>
                </Grid>
            </Border>

            <!-- 右侧：结果区域 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <!-- 统计卡片 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,8">

                    <Border Classes="card" Grid.Column="0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="总计" Foreground="Gray" FontSize="12"/>
                            <TextBlock Classes="stat-value" Text="{Binding Stats.Total}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✅ 有效" Foreground="Gray" FontSize="12"/>
                            <TextBlock Classes="stat-value" Text="{Binding Stats.Valid}" Foreground="#4EC9B0"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="❌ 无效" Foreground="Gray" FontSize="12"/>
                            <TextBlock Classes="stat-value" Text="{Binding Stats.Invalid}" Foreground="#F14C4C"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠️ 错误" Foreground="Gray" FontSize="12"/>
                            <TextBlock Classes="stat-value" Text="{Binding Stats.Error}" Foreground="#CCA700"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- 结果列表 -->
                <Border Grid.Row="1" Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Classes="title" Text="检测结果"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="导出有效" Name="ExportButton"
                                        Margin="0,0,8,0" FontSize="12" Padding="8,4"/>
                                <Button Content="清空" Command="{Binding ClearResultsCommand}"
                                        FontSize="12" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Results}"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  FontFamily="Consolas, monospace"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusIcon}" Width="50"/>
                                <DataGridTextColumn Header="API Key" Binding="{Binding MaskedKey}" Width="*"/>
                                <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="100"/>
                                <DataGridTextColumn Header="延迟" Binding="{Binding LatencyMs, StringFormat={}{0}ms}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 进度条 -->
                        <ProgressBar Grid.Row="2"
                                     Value="{Binding Progress}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,8,0,0"
                                     IsVisible="{Binding IsRunning}"/>

                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="速度: " Foreground="Gray"/>
                    <TextBlock Text="{Binding Stats.KeysPerSecond, StringFormat={}{0:F1} keys/s}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Window>
